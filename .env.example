# Qlik Cloud Tenant Hostname (e.g., cliqvenus.ap.qlikcloud.com or your-tenant.us.qlikcloud.com)
VITE_QLIK_HOST=cliqvenus.ap.qlikcloud.com

# Qlik Sense App ID (UUID of the app)
VITE_QLIK_APP_ID=53b13125-7bb8-4ff0-b5bc-9e2704b0363e

# Qlik Web Integration ID (created in Qlik Management Console under Web Integrations)
VITE_QLIK_WEB_INTEGRATION_ID=M56RlXSVJ0dcpleLLpIdU1oPwI9sDQxJ

# The origin of your local application (e.g., http://localhost:5173).
# Make sure this exact origin is added to the "Allowed origins" list in the Qlik Web Integration configuration.
VITE_APP_ORIGIN=http://localhost:5173
